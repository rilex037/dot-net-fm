<Window x:Class="DotNetFM.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ShowInTaskbar="False"
        Topmost="False">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="{StaticResource CornerRadiusLarge}" ResizeBorderThickness="0" CaptionHeight="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource ToolbarBrush}"
            CornerRadius="{StaticResource CornerRadiusLarge}"
            Padding="28"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Grid MinWidth="340" MaxWidth="480">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="TitleText"
                       FontSize="{StaticResource FontFileNameSize}"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,10"/>

            <TextBlock Grid.Row="1" x:Name="LabelText"
                       FontSize="{StaticResource FontStatusSize}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,8"/>

            <Border Grid.Row="2" Background="{StaticResource InputBackground}"
                    BorderBrush="{StaticResource SeparatorBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusMedium}"
                    Margin="0,0,0,20">
                <TextBox x:Name="ValueBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         FontSize="{StaticResource FontAddressSize}"
                         Padding="{StaticResource SpacingAddressBarPadding}"
                         VerticalContentAlignment="Center"
                         CaretBrush="{StaticResource AccentBrush}"/>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" MinWidth="88" Height="30" IsDefault="True"
                        Style="{StaticResource DialogButton}" Click="OK_Click"/>
                <Button Content="Cancel" MinWidth="88" Height="30" Margin="8,0,0,0" IsCancel="True"
                        Style="{StaticResource DialogButton}" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
