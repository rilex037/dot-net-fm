<Window x:Class="DotNetFM.BookmarkManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="CanResize"
        MinWidth="460" MinHeight="340"
        Width="560" Height="420"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="{StaticResource CornerRadiusLarge}" ResizeBorderThickness="1" CaptionHeight="28"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource ToolbarBrush}"
            CornerRadius="{StaticResource CornerRadiusLarge}"
            Padding="20"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Manage Bookmarks"
                       FontSize="{StaticResource FontFileNameSize}"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,14"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="BookmarksList" Grid.Column="0"
                         Background="{StaticResource InputBackground}"
                         BorderBrush="{StaticResource SeparatorBrush}"
                         BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,1">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="{StaticResource FontSidebarItemSize}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Path=Path}"
                                           FontSize="{StaticResource FontFileDetailsSize}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent"
                                                CornerRadius="4" Padding="8,5" Margin="2">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverHighlightBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedItemBackground}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Content="Move _Up" Width="104" Height="28" Margin="0,0,0,6"
                            Style="{StaticResource DialogButton}" Click="MoveUp_Click"/>
                    <Button Content="Move _Down" Width="104" Height="28" Margin="0,0,0,6"
                            Style="{StaticResource DialogButton}" Click="MoveDown_Click"/>
                    <Button Content="_Rename…" Width="104" Height="28" Margin="0,0,0,6"
                            Style="{StaticResource DialogButton}" Click="Rename_Click"/>
                    <Button Content="Re_move" Width="104" Height="28"
                            Style="{StaticResource DialogButton}" Click="Remove_Click"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="OK" MinWidth="88" Height="30" IsDefault="True"
                        Style="{StaticResource DialogButton}" Click="OK_Click"/>
                <Button Content="Cancel" MinWidth="88" Height="30" Margin="8,0,0,0" IsCancel="True"
                        Style="{StaticResource DialogButton}" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
