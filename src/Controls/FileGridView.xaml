<UserControl x:Class="DotNetFM.FileGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DotNetFM">

    <UserControl.Resources>
        <Thickness x:Key="ItemMargin">4</Thickness>
        <Thickness x:Key="ItemPadding">6,8,6,6</Thickness>

        <!-- Rename selection highlight. RenameTextBox paints it behind the text, so the text stays white. -->
        <SolidColorBrush x:Key="RenameSelection" Color="#8A1038"/>

        <Style x:Key="ScrollThumbs" TargetType="Thumb">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="RectangleCorner"
                                Margin="2,0"
                                Background="{StaticResource ScrollThumbDefault}"
                                CornerRadius="{StaticResource CornerRadiusScrollThumb}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RectangleCorner" Property="Background" Value="{StaticResource ScrollThumbHover}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="RectangleCorner" Property="Background" Value="{StaticResource ScrollThumbDragging}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Width" Value="{StaticResource SizeScrollBarWidth}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" Background="{StaticResource ScrollTrack}" ClipToBounds="True" Width="{TemplateBinding Width}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbs}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}" ClipToBounds="True">

        <ScrollViewer x:Name="FileScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent"
                      Margin="0,0,5,0"
                      PreviewMouseWheel="FileScrollViewer_PreviewMouseWheel">

            <ItemsControl x:Name="FolderItemsControl" Margin="{StaticResource SpacingContentMargin}"
                          ItemsSource="{Binding Folders, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True" Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="local:FolderItem">
                        <Border x:Name="ItemBorder" Cursor="Hand"
                                Margin="{DynamicResource ItemMargin}">
                            <!-- ItemPanel is the click area (thumbnail + label). The margins around it are not. -->
                            <StackPanel x:Name="ItemPanel"
                                        Background="Transparent"
                                        Orientation="Vertical"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Margin="{DynamicResource ItemPadding}"
                                        Width="{Binding IconSize,
                                                RelativeSource={RelativeSource AncestorType=local:FileGridView},
                                                Converter={StaticResource IconWidthConverter}}">

                                <Border Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=local:FileGridView}}"
                                        HorizontalAlignment="Stretch"
                                        Margin="{StaticResource SpacingIconBottomMargin}">
                                    <Image x:Name="IconImage"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom"
                                           MaxWidth="{Binding IconSize, RelativeSource={RelativeSource AncestorType=local:FileGridView}}"
                                           MaxHeight="{Binding IconSize, RelativeSource={RelativeSource AncestorType=local:FileGridView}}"
                                           Source="{Binding NativeIcon}"/>
                                </Border>

                                <!-- Label box: name + details. This is what turns pink when selected. -->
                                <Border x:Name="NameHost"
                                        HorizontalAlignment="Stretch"
                                        Padding="4,2"
                                        CornerRadius="{StaticResource CornerRadiusLarge}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=ItemBorder}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource HoverHighlightBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel Orientation="Vertical">
                                        <Grid>
                                            <TextBlock x:Name="NameText"
                                                       Text="{Binding Name}"
                                                       FontSize="{StaticResource FontFileNameSize}"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <local:RenameTextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent"
                                                     Foreground="{StaticResource WhiteBrush}"
                                                     FontFamily="{StaticResource AppFont}"
                                                     FontSize="{StaticResource FontFileNameSize}"
                                                     BorderThickness="0"
                                                     Padding="0"
                                                     Margin="0"
                                                     HorizontalAlignment="Stretch"
                                                     TextAlignment="Center"
                                                     TextWrapping="Wrap"
                                                     VerticalContentAlignment="Center"
                                                     CaretBrush="{StaticResource WhiteBrush}"
                                                     SelectionBrush="{StaticResource RenameSelection}"
                                                     SelectionOpacity="0"
                                                     KeyDown="RenameBox_KeyDown"
                                                     LostFocus="RenameBox_LostFocus">
                                                <local:RenameTextBox.Style>
                                                    <Style TargetType="local:RenameTextBox">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </local:RenameTextBox.Style>
                                            </local:RenameTextBox>
                                        </Grid>

                                        <TextBlock Text="{Binding ItemCount}"
                                                   IsHitTestVisible="False"
                                                   FontSize="{StaticResource FontFileDetailsSize}"
                                                   TextWrapping="Wrap"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   Margin="{StaticResource SpacingItemCountMargin}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
