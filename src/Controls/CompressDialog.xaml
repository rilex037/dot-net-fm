<Window x:Class="DotNetFM.CompressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0"
                      CornerRadius="{StaticResource CornerRadiusLarge}"
                      ResizeBorderThickness="0"
                      CaptionHeight="28"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource ToolbarBrush}"
            CornerRadius="{StaticResource CornerRadiusLarge}"
            Padding="24"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontSize="{StaticResource FontSectionHeaderSize}"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,14"/>

            <TextBlock Text="Archive name"
                       FontSize="{StaticResource FontFileDetailsSize}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,6"/>

            <Border Background="{StaticResource InputBackground}"
                    CornerRadius="{StaticResource CornerRadiusMedium}"
                    Margin="0,0,0,14">
                <TextBox x:Name="NameBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         FontSize="{StaticResource FontAddressSize}"
                         Padding="{StaticResource SpacingAddressBarPadding}"
                         VerticalContentAlignment="Center"
                         CaretBrush="{StaticResource AccentBrush}"/>
            </Border>

            <TextBlock Text="Format"
                       FontSize="{StaticResource FontFileDetailsSize}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,6"/>

            <StackPanel x:Name="FormatPanel" Margin="4,0,0,4"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="OK" MinWidth="88" Height="30" IsDefault="True"
                        Style="{StaticResource DialogButton}" Click="OK_Click"/>
                <Button Content="Cancel" MinWidth="88" Height="30" Margin="8,0,0,0" IsCancel="True"
                        Style="{StaticResource DialogButton}" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
